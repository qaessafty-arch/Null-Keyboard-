{
  "name": "neo-type",
  "private": true,
  "version": "1.2.0",
  "description": "NULL-TECH — spatial input: a laser keyboard you can touch or type on in the air",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "postinstall": "node scripts/setup-assets.mjs",
    "setup:assets": "node scripts/setup-assets.mjs",
    "dev": "vite",
    "dev:lan": "vite --mode lan",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "start": "npm run build && node server/index.ts",
    "serve": "node server/index.ts",
    "typecheck": "tsc -b",
    "test": "vitest run --mode test",
    "test:watch": "vitest --mode test",
    "test:e2e": "playwright test --trace off"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.2.3",
    "motion": "14.14.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "selfsigned": "5.5.0",
    "three": "0.187.0",
    "uqr": "0.1.3",
    "ws": "8.23.0",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "8.0.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "6.3.0",
    "jsdom": "31.0.1",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.1.1"
  }
}
