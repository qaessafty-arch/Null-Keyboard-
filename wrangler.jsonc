// Cloudflare Workers deployment (free plan). See README → "Put it online".
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "null-keyboard",
  // Must match the deployed Worker name, or deploys create a second site.
  "workers_dev": true,
  "preview_urls": false,
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  // node:crypto for the shared SignalingHub (room codes, tokens)
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "durable_objects": {
    "bindings": [{ "name": "HUB", "class_name": "SignalHub" }]
  },
  // SQLite-backed Durable Objects are included in the Workers Free plan.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SignalHub"] }]
}
