# Security headers for static hosting (Cloudflare Workers Static Assets).
# Mirrors SECURITY_HEADERS in server/index.ts — keep the two in sync.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  X-Frame-Options: DENY
  Permissions-Policy: camera=(self), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self' wss: ws: https://storage.googleapis.com; worker-src 'self' blob:; frame-ancestors 'none'

/assets/*
  Cache-Control: public, max-age=31536000, immutable
